    <!-- Smooth collision support plane -->
    <model name="vo_collision_support_base">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="support_link">
        <pose>0 0 -0.001 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>90.0 90.0 0.002</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

