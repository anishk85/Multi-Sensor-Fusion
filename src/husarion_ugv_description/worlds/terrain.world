<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
  <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8066</gravity>
    <physics name="default_physics" type="dart">
        <max_step_size>0.004</max_step_size>
        <real_time_factor>1</real_time_factor>
    </physics>
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <!-- A global light source -->
  <model name='terrain'>
    <static>true</static>
    <pose>1 -1 -1.5 0 0 0</pose>
      <link name='terrain_surface'>
        <collision name="collision">
          <geometry>
            <mesh><uri>surface1.stl</uri></mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh><uri>surface1.stl</uri></mesh>
          </geometry>
          <material> <ambient>0.8 0.5 0.3 1</ambient>
    <diffuse>0.8 0.5 0.3 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
    <pbr>
      <metal>
        <albedo_map>Materials/Mars_surface.jpg</albedo_map>
      </metal>
    </pbr>
  </material>
        </visual>
      </link>
    </model>
    <spherical_coordinates>
    <surface_model>EARTH_WGS84</surface_model>
    <latitude_deg>49.9</latitude_deg>
    <longitude_deg>8.9</longitude_deg>
    <elevation>0</elevation>
    <heading_deg>0</heading_deg>
  </spherical_coordinates>
  </world>
</sdf>
