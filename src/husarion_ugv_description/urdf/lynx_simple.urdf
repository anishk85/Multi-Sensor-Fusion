<?xml version="1.0" encoding="utf-8"?>
<!--
  Husarion Lynx - 4WD Differential Drive Robot with Sensors

  Sensors:
    - IMU            : MEMS-grade, mounted at body center (200 Hz)
    - GPS            : u-blox M8N-class NavSat, top of chassis (10 Hz)
    - LiDAR          : Velodyne VLP-16 equivalent, top mount (10 Hz, 16-beam 3D)
    - Depth Camera   : Intel RealSense D435, front-facing (30 Hz, 640x480 RGBD)

  Wheel config (WH05):
    Body mass:      30.656 kg
    Wheel radius:   0.1348 m
    Wheelbase:      0.35 m
    Track width:    0.455 m
-->
<robot name="lynx">

  <!-- Base link is a massless reference frame at the robot center -->
  <link name="base_link" />

  <joint name="base_to_body_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    <parent link="base_link" />
    <child link="body_link" />
  </joint>

  <!-- Main chassis with visual, collision, and inertia -->
  <link name="body_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="file:///home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/meshes/lynx/base.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="file:///home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/meshes/lynx/base_collision.dae" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.052 0.001 0.038" rpy="0.0 0.0 0.0" />
      <mass value="30.656" />
      <inertia ixx="0.6572" ixy="0.0334" ixz="0.1739"
                            iyy="1.443"  iyz="0.0082"
                                         izz="1.598" />
    </inertial>
  </link>

  <!-- Ground projection frame, sits on the floor plane -->
  <joint name="body_to_footprint_joint" type="fixed">
    <origin xyz="0.0 0.0 -0.1348" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="base_footprint" />
  </joint>

  <link name="base_footprint" />

  <!-- =================================================================
       Wheels
       fl = front-left   fr = front-right
       rl = rear-left    rr = rear-right
       ================================================================= -->

  <!-- Front-Left Wheel -->
  <joint name="body_to_fl_wheel_base_joint" type="fixed">
    <origin xyz="0.175 0.1675 0.0" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="fl_wheel_base_link" />
  </joint>

  <link name="fl_wheel_base_link" />

  <joint name="fl_wheel_joint" type="continuous">
    <origin xyz="0.0 0.06 0.0" rpy="0.0 0.0 0.0" />
    <parent link="fl_wheel_base_link" />
    <child link="fl_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="64.5" velocity="11.2" />
    <dynamics damping="0.01" friction="0.1" />
  </joint>

  <link name="fl_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="file:///home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/meshes/WH05/fl_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0" />
      <geometry>
        <cylinder radius="0.1348" length="0.09" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <mass value="2.036" />
      <inertia ixx="0.014738" ixy="0.0" ixz="0.0"
                              iyy="0.02593" iyz="0.0"
                                            izz="0.014738" />
    </inertial>
  </link>

  <!-- Front-Right Wheel -->
  <joint name="body_to_fr_wheel_base_joint" type="fixed">
    <origin xyz="0.175 -0.1675 0.0" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="fr_wheel_base_link" />
  </joint>

  <link name="fr_wheel_base_link" />

  <joint name="fr_wheel_joint" type="continuous">
    <origin xyz="0.0 -0.06 0.0" rpy="0.0 0.0 0.0" />
    <parent link="fr_wheel_base_link" />
    <child link="fr_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="64.5" velocity="11.2" />
    <dynamics damping="0.01" friction="0.1" />
  </joint>

  <link name="fr_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="file:///home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/meshes/WH05/fr_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0" />
      <geometry>
        <cylinder radius="0.1348" length="0.09" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <mass value="2.036" />
      <inertia ixx="0.014738" ixy="0.0" ixz="0.0"
                              iyy="0.02593" iyz="0.0"
                                            izz="0.014738" />
    </inertial>
  </link>

  <!-- Rear-Left Wheel -->
  <joint name="body_to_rl_wheel_base_joint" type="fixed">
    <origin xyz="-0.175 0.1675 0.0" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="rl_wheel_base_link" />
  </joint>

  <link name="rl_wheel_base_link" />

  <joint name="rl_wheel_joint" type="continuous">
    <origin xyz="0.0 0.06 0.0" rpy="0.0 0.0 0.0" />
    <parent link="rl_wheel_base_link" />
    <child link="rl_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="64.5" velocity="11.2" />
    <dynamics damping="0.01" friction="0.1" />
  </joint>

  <link name="rl_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="file:///home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/meshes/WH05/rl_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0" />
      <geometry>
        <cylinder radius="0.1348" length="0.09" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <mass value="2.036" />
      <inertia ixx="0.014738" ixy="0.0" ixz="0.0"
                              iyy="0.02593" iyz="0.0"
                                            izz="0.014738" />
    </inertial>
  </link>

  <!-- Rear-Right Wheel -->
  <joint name="body_to_rr_wheel_base_joint" type="fixed">
    <origin xyz="-0.175 -0.1675 0.0" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="rr_wheel_base_link" />
  </joint>

  <link name="rr_wheel_base_link" />

  <joint name="rr_wheel_joint" type="continuous">
    <origin xyz="0.0 -0.06 0.0" rpy="0.0 0.0 0.0" />
    <parent link="rr_wheel_base_link" />
    <child link="rr_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="64.5" velocity="11.2" />
    <dynamics damping="0.01" friction="0.1" />
  </joint>

  <link name="rr_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="file:///home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/meshes/WH05/rr_wheel.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0" />
      <geometry>
        <cylinder radius="0.1348" length="0.09" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <mass value="2.036" />
      <inertia ixx="0.014738" ixy="0.0" ixz="0.0"
                              iyy="0.02593" iyz="0.0"
                                            izz="0.014738" />
    </inertial>
  </link>

  <!-- =================================================================
       Sensors

       All sensor links are fixed to body_link. The joints define
       where each sensor sits on the physical chassis.

       Coordinate origin for positions: body_link frame origin.
       The body sits roughly 0.1348m (wheel radius) above ground.
       ================================================================= -->

  <!-- IMU — mounted inside the chassis at center of body.
       Oriented so that x points forward, y points left, z points up. -->
  <joint name="body_to_imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="imu_link" />
  </joint>

  <link name="imu_link">
    <inertial>
      <!-- Effectively massless — IMU chip, not the housing -->
      <mass value="0.001" />
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0"
                          iyy="1e-9" iyz="0.0"
                                     izz="1e-9" />
    </inertial>
  </link>

  <!-- LiDAR — Velodyne VLP-16 puck on top of the chassis.
       z = 0.26 m places it just above the body cover. -->
  <joint name="body_to_lidar_joint" type="fixed">
    <origin xyz="0.0 0.0 0.26" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="lidar_link" />
  </joint>

  <link name="lidar_link">
    <visual>
      <!-- VLP-16 puck: ~103mm diameter, 72mm tall -->
      <origin xyz="0.0 0.0 0.036" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.0515" length="0.072" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.036" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.0515" length="0.072" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.83" />
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0"
                            iyy="0.0004" iyz="0.0"
                                         izz="0.0005" />
    </inertial>
  </link>

  <!-- GPS — small antenna mounted at rear-top of chassis.
       Placed behind the LiDAR to avoid occlusion. -->
  <joint name="body_to_gps_joint" type="fixed">
    <origin xyz="-0.12 0.0 0.27" rpy="0.0 0.0 0.0" />
    <parent link="body_link" />
    <child link="gps_link" />
  </joint>

  <link name="gps_link">
    <visual>
      <!-- Small GPS puck -->
      <origin xyz="0.0 0.0 0.012" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.025" length="0.024" />
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.012" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.025" length="0.024" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05" />
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
                          iyy="1e-5" iyz="0.0"
                                     izz="1e-5" />
    </inertial>
  </link>

  <!-- RealSense D435 — mounted AHEAD of the front face, angled DOWN (~20°)
       to see both ground features AND horizon objects for visual odometry.
       x=0.38 places it past the chassis front, z=0.20 gives clearance.
       pitch = +0.35 rad ≈ 20° downward — enough ground view without
       making ALL features coplanar (which breaks essential matrix). -->
  <joint name="body_to_camera_joint" type="fixed">
    <origin xyz="0.38 0.0 0.20" rpy="0.0 0.35 0.0" />
    <parent link="body_link" />
    <child link="camera_link" />
  </joint>

  <link name="camera_link">
    <visual>
      <!-- D435 bar: 90mm wide, 25mm tall, 25mm deep -->
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.025 0.090 0.025" />
      </geometry>
      <material name="camera_grey">
        <color rgba="0.15 0.15 0.15 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.025 0.090 0.025" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072" />
      <inertia ixx="4.15e-5" ixy="0.0" ixz="0.0"
                             iyy="4.15e-5" iyz="0.0"
                                           izz="8.15e-5" />
    </inertial>
  </link>

  <!-- Camera optical frame — rotated to standard camera convention
       (z forward, x right, y down) as expected by image_geometry etc. -->
  <joint name="camera_to_optical_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 -1.5708" />
    <parent link="camera_link" />
    <child link="camera_optical_link" />
  </joint>

  <link name="camera_optical_link" />

  <!-- =================================================================
       ros2_control — hardware interface for Gazebo Harmonic

       The GazeboSimSystem plugin connects the ros2_control controller
       manager to Gazebo's physics. All four wheels are controlled via
       velocity commands and report position, velocity, and effort state.
       ================================================================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="fl_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-11.2</param>
        <param name="max">11.2</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="fr_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-11.2</param>
        <param name="max">11.2</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="rl_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-11.2</param>
        <param name="max">11.2</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="rr_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-11.2</param>
        <param name="max">11.2</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>

  <!-- Gazebo plugin that loads the ros2_control controller manager.
       cmd_vel_unstamped is remapped to /cmd_vel for Nav2 compatibility. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/anish/Multi-sensor-fusion/install/husarion_ugv_description/share/husarion_ugv_description/config/controllers.yaml</parameters>
      <ros>
        <remapping>~/robot_description:=/robot_description</remapping>
        <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- =================================================================
       Wheel Surface Friction for Gazebo
       mu/mu2 = 1.0 matches agriculture.world terrain friction (mu=1.0).
       ODE contact = sqrt(mu_wheel * mu_terrain), so 1.0*1.0 = 1.0 effective.
       Previous mu=1.5 → effective 1.22 → over-grip → jitter on tile seams.
       kp reduced 1e6→5e4: softer contact prevents bouncing at tile edges.
       kd increased 100→200: more damping to suppress oscillation at seams.
       ================================================================= -->
  <gazebo reference="fl_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>5e4</kp>
    <kd>200.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="fr_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>5e4</kp>
    <kd>200.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="rl_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>5e4</kp>
    <kd>200.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="rr_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>5e4</kp>
    <kd>200.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- =================================================================
       Gazebo Sensor Configs

       Sensor plugins and noise models are defined here as <gazebo>
       reference blocks. These only take effect in Gazebo simulation.
       The world SDF must load the matching system plugins:
         gz-sim-imu-system, gz-sim-navsat-system, gz-sim-sensors-system
       ================================================================= -->

  <!-- IMU Sensor
       Noise values based on a typical MEMS IMU (e.g., BMI088):
         gyro noise density  ~0.014 °/s/√Hz → ~0.009 rad/s at 200 Hz
         accel noise density ~80 μg/√Hz     → ~0.021 m/s² at 200 Hz -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.001</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.001</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.001</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>400.0</dynamic_bias_correlation_time>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
              <dynamic_bias_stddev>0.0002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
              <dynamic_bias_stddev>0.0002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
              <dynamic_bias_stddev>0.0002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>300.0</dynamic_bias_correlation_time>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- GPS / NavSat Sensor
       IMPORTANT: In Gazebo Harmonic NavSat, latitude/longitude noise is
       applied in angular units (degrees). So stddev must be very small.
       Approx conversions near Earth surface:
         0.5 m  ≈ 4.5e-6 deg latitude
         1.0 m  ≈ 9.0e-6 deg latitude -->
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>4.5e-6</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>9.0e-6</stddev>
            </noise>
          </vertical>
        </position_sensing>
        <velocity_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.1</stddev>
            </noise>
          </vertical>
        </velocity_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- LiDAR — Velodyne VLP-16 equivalent
       16 vertical channels, -15° to +15°, 360° horizontal, 100m range.
       Noise: ±3cm (stddev = 0.01m) matches the VLP-16 datasheet.
       Requires gz-sim-sensors-system with ogre2 in the world. -->
  <gazebo reference="lidar_link">
    <sensor name="velodyne_vlp16" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <topic>lidar</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26180</min_angle>  <!-- -15 degrees -->
            <max_angle>0.26180</max_angle>   <!-- +15 degrees -->
          </vertical>
        </scan>
        <range>
          <min>0.4</min>
          <max>100.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- RealSense D435 Depth Camera
       Specs: 87°×57° FOV, 640×480 at 30fps, depth range 0.105–10m.
       horizontal_fov = 87° = 1.5184 rad
       Depth noise: ≈ 0.5–2% of range → stddev = 0.01m is a reasonable sim value. -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d435" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>realsense</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.105</near>  <!-- D435 minimum depth: 10.5 cm -->
            <far>10.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- Ground Truth Odometry Publisher
       Publishes the true model pose from Gazebo physics (zero noise) to
       /ground_truth/odom as nav_msgs/Odometry.  Used in notebooks for
       rigorous drift measurement instead of the GPS-noisy global EKF. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>
  </gazebo>

</robot>
