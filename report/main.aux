\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces ROS\,2 TF frame hierarchy. EKF\,\#1 publishes \texttt  {odom}$\rightarrow $\texttt  {base\_link}; EKF\,\#2 publishes \texttt  {map}$\rightarrow $\texttt  {odom}. The \texttt  {navsat\_transform} node converts GPS to Cartesian but its output is not injected into EKF\,\#2. \texttt  {use\_odometry\_yaw = true} breaks the potential circular dependency by sourcing heading from EKF\,\#1 (which has no GPS input).}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:tf_hierarchy}{{3}{4}{ROS\,2 TF frame hierarchy. EKF\,\#1 publishes \texttt {odom}$\rightarrow $\texttt {base\_link}; EKF\,\#2 publishes \texttt {map}$\rightarrow $\texttt {odom}. The \texttt {navsat\_transform} node converts GPS to Cartesian but its output is not injected into EKF\,\#2. \texttt {use\_odometry\_yaw = true} breaks the potential circular dependency by sourcing heading from EKF\,\#1 (which has no GPS input)}{figure.3}{}}
